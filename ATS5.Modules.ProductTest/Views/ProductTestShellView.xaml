<UserControl x:Class="ATS5.Modules.ProductTest.Views.ProductTestShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             FontFamily="Microsoft YaHei UI"
             Background="#F3F5F7">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top"
                 Height="32">
            <Button Content="执行"
                    Command="{Binding ExecuteCommand}"/>
            <Button Content="暂停"
                    Command="{Binding PauseCommand}"/>
            <Button Content="停止"
                    Command="{Binding StopCommand}"/>
            <Button Content="清除报警"
                    IsEnabled="False"/>
            <Separator/>
            <Button Content="{Binding SelectedChannel.FlowName, StringFormat=【流程：{0}】}"
                    IsEnabled="False"/>
            <Button Content="导出"
                    IsEnabled="False"/>
            <Button Content="CAN监控"
                    IsEnabled="False"/>
        </ToolBar>

        <TabControl ItemsSource="{Binding Channels}"
                    SelectedItem="{Binding SelectedChannel, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0"
                                  Grid.Column="0"
                                  Header="测试信息">
                            <DataGrid AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="测试项目"
                                                        Width="160"/>
                                    <DataGridTextColumn Header="测试点"
                                                        Width="160"/>
                                    <DataGridTextColumn Header="数据类型"
                                                        Width="90"/>
                                    <DataGridTextColumn Header="下限"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="上限"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="单位"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="测试值"
                                                        Width="100"/>
                                    <DataGridTextColumn Header="结果"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="判定符号"
                                                        Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Grid.Row="2"
                                  Grid.Column="0"
                                  Header="消息">
                            <DataGrid ItemsSource="{Binding Messages}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间"
                                                        Width="160"/>
                                    <DataGridTextColumn Header="类型"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="消息"
                                                        Width="*"
                                                        Binding="{Binding}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Grid.Row="0"
                                  Grid.Column="2"
                                  Header="当前测试">
                            <StackPanel Margin="8">
                                <TextBlock Text="起始时间"/>
                                <TextBox IsReadOnly="True"
                                         Margin="0,2,0,8"/>
                                <TextBlock Text="耗时"/>
                                <TextBox IsReadOnly="True"
                                         Margin="0,2,0,8"/>
                                <ItemsControl ItemsSource="{Binding Barcodes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <GroupBox Header="{Binding}"
                                                      Margin="0,4">
                                                <TextBlock Text="WaitTest"
                                                           HorizontalAlignment="Center"
                                                           FontSize="24"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           Background="#106EBE"
                                                           Padding="12,4"/>
                                            </GroupBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="2"
                                  Grid.Column="2"
                                  Header="系统消息">
                            <DataGrid AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="类别"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="名称"
                                                        Width="120"/>
                                    <DataGridTextColumn Header="值"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="描述"
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</UserControl>
