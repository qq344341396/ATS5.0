<Window x:Class="ATS5.Modules.ProductTest.Views.BarcodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Request.ChannelNumber, StringFormat=通道：{0} 条码输入}"
        Width="520"
        Height="360"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Topmost="True"
        FontFamily="Microsoft YaHei UI">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="8">
            <Button Content="确定"
                    Width="66"
                    Height="24"
                    Margin="0,0,34,0"
                    Click="Confirm_Click"/>
            <Button Content="取消"
                    Width="66"
                    Height="24"
                    Click="Cancel_Click"/>
        </StackPanel>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="流程文件"
                       TextAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,50,0"/>
            <ComboBox Grid.Row="0"
                      Grid.Column="1"
                      ItemsSource="{Binding Request.AvailableFlowNames}"
                      SelectedItem="{Binding SelectedFlowName, Mode=TwoWay}"
                      Text="{Binding SelectedFlowName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True"/>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="单通道条码数量"
                       TextAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,50,0"/>
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Width="65"
                     HorizontalAlignment="Left"
                     Text="{Binding BarcodeCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <ItemsControl Grid.Row="3"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          ItemsSource="{Binding BarcodeInputs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132"/>
                                <ColumnDefinition Width="330"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Label}"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,50,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="Barcode_PreviewKeyDown"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="4"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Text="{Binding ErrorMessage}"
                       Foreground="#A33118"
                       VerticalAlignment="Center"/>
        </Grid>
    </DockPanel>
</Window>
