<UserControl x:Class="ATS5.Modules.DataQuery.Views.DataQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             FontFamily="Microsoft YaHei UI"
             Background="White">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AtsBlueBrush" Color="#106EBE"/>
        <SolidColorBrush x:Key="AtsBorderBrush" Color="#D7E1EC"/>
        <SolidColorBrush x:Key="AtsToolbarBrush" Color="#F6F9FC"/>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#BFD2E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8F3FC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#CDE7FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryToolbarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AtsBlueBrush}"/>
            <Setter Property="BorderBrush" Value="#0D5D9F"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="25"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource AtsBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E2E8F0"/>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Height="24"
                Background="{StaticResource AtsToolbarBrush}"
                BorderBrush="{StaticResource AtsBorderBrush}"
                BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="4,0">
                    <TextBlock Text="日期"
                               VerticalAlignment="Center"
                               Margin="4,0"/>
                    <DatePicker Width="124"
                                Height="22"
                                SelectedDate="{Binding StartDate}"/>
                    <TextBlock Text="至"
                               VerticalAlignment="Center"
                               Margin="6,0"/>
                    <DatePicker Width="124"
                                Height="22"
                                SelectedDate="{Binding EndDate}"/>

                    <CheckBox Content="条码"
                              Margin="10,0,2,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsBarcodeFilterEnabled}"/>
                    <TextBox Width="145"
                             Height="22"
                             IsEnabled="{Binding IsBarcodeFilterEnabled}"
                             Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"/>

                    <CheckBox Content="通道号"
                              Margin="10,0,2,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsChannelFilterEnabled}"/>
                    <hc:NumericUpDown Width="70"
                                      Height="22"
                                      IsEnabled="{Binding IsChannelFilterEnabled}"
                                      Value="{Binding Channel}"/>

                    <CheckBox Content="流程"
                              Margin="10,0,2,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsFlowFilterEnabled}"/>
                    <TextBox Width="145"
                             Height="22"
                             IsEnabled="{Binding IsFlowFilterEnabled}"
                             Text="{Binding FlowName, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Style="{StaticResource PrimaryToolbarButtonStyle}"
                            Command="{Binding QueryCommand}"
                            Content="查询"
                            Margin="10,0,2,0"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Content="日志导出"
                            IsEnabled="False"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Content="MES上传"
                            Command="{Binding ManualMesUploadCommand}"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Content="全部展开"
                            IsEnabled="False"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Content="全部收合"
                            IsEnabled="False"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Content="数据导出"
                            IsEnabled="False"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StatusBar DockPanel.Dock="Bottom"
                   Height="24"
                   Background="#FAFCFE"
                   BorderBrush="{StaticResource AtsBorderBrush}"
                   BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Message}"/>
            <Separator/>
            <TextBlock Text="{Binding CurrentPage, StringFormat=第 {0} 页}"/>
            <Separator/>
            <TextBlock Text="{Binding TotalCount, StringFormat=总数 {0}}"/>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="42*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="58*"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="RecordsGrid"
                          Grid.Row="0"
                          Style="{StaticResource GridStyle}"
                          ItemsSource="{Binding Records}"
                          SelectedItem="{Binding SelectedRecord}"
                          SelectionMode="Extended"
                          SelectionChanged="RecordsGrid_OnSelectionChanged"
                          IsReadOnly="True">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="MES上传"
                                      Command="{Binding PlacementTarget.DataContext.ManualMesUploadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="数据导出" IsEnabled="False"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="LogGuid" Binding="{Binding LogGuid}" Width="95"/>
                        <DataGridTextColumn Header="通道号" Binding="{Binding Channel}" Width="58"/>
                        <DataGridTextColumn Header="条码" Binding="{Binding Barcode}" Width="170"/>
                        <DataGridTextColumn Header="流程名称" Binding="{Binding ProcessName}" Width="130"/>
                        <DataGridTextColumn Header="流程信息" Binding="{Binding ProcessInfo}" Width="80"/>
                        <DataGridTextColumn Header="开始时间" Binding="{Binding TestStartTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="135"/>
                        <DataGridTextColumn Header="结束时间" Binding="{Binding TestEndTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="135"/>
                        <DataGridTextColumn Header="耗时(S)" Binding="{Binding TakeTime}" Width="70"/>
                        <DataGridTextColumn Header="上传MES状态" Binding="{Binding UploadMesStatus}" Width="92"/>
                        <DataGridTextColumn Header="结果" Binding="{Binding TestResult}" Width="62"/>
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel Grid.Row="0"
                           Height="28"
                           VerticalAlignment="Bottom"
                           Background="#F5F8FB"
                           LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="PageSize: 200"
                               VerticalAlignment="Center"
                               Margin="8,0"/>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding TotalCount, StringFormat=TotalSize: {0}}"
                               VerticalAlignment="Center"
                               Margin="8,0"/>
                </DockPanel>

                <GridSplitter Grid.Row="1"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              Background="#D7E1EC"/>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="#F7FAFD"
                            BorderBrush="{StaticResource AtsBorderBrush}"
                            BorderThickness="1,0,1,1">
                        <Grid Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="76"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="流程名" VerticalAlignment="Top" Margin="0,6,8,0"/>
                            <TextBox Grid.Column="1" Height="22" VerticalAlignment="Top" Margin="0,3,0,0" Text="{Binding StatisticsFlowName}"/>
                            <TextBlock Grid.Column="2" Text="测试项" VerticalAlignment="Top" Margin="8,6,8,0"/>
                            <TextBox Grid.Column="4" Height="22" VerticalAlignment="Top" Margin="0,3,0,0" Text="{Binding StatisticsProjectName}"/>
                            <TextBlock Grid.Column="0" Text="时间" VerticalAlignment="Bottom" Margin="0,0,8,6"/>
                            <DatePicker Grid.Column="1" Height="22" VerticalAlignment="Bottom" Margin="0,0,0,3" SelectedDate="{Binding StatisticsStartTime}"/>
                            <TextBlock Grid.Column="2" Text="至" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <DatePicker Grid.Column="4" Height="22" VerticalAlignment="Bottom" Margin="0,0,0,3" SelectedDate="{Binding StatisticsEndTime}"/>
                            <Button Grid.Column="6"
                                    Style="{StaticResource PrimaryToolbarButtonStyle}"
                                    Content="确定"
                                    Command="{Binding QueryCommand}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="{StaticResource AtsBorderBrush}"
                            BorderThickness="1,0,1,1">
                        <Grid>
                            <TextBlock Text="统计图区域"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#7A8794"
                                       FontSize="13"/>
                            <ItemsControl HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="0,34,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <Border Width="14" Height="14" Background="#2DA44E" CornerRadius="7" Margin="8,0"/>
                                <TextBlock Text="PASS" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Border Width="14" Height="14" Background="#8B4513" CornerRadius="7" Margin="8,0"/>
                                <TextBlock Text="FAIL" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Border Width="14" Height="14" Background="#106EBE" CornerRadius="7" Margin="8,0"/>
                                <TextBlock Text="其他" VerticalAlignment="Center"/>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#D7E1EC"/>

            <DataGrid Grid.Column="2"
                      Style="{StaticResource GridStyle}"
                      ItemsSource="{Binding Details}"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="测试项目" Binding="{Binding ProjectName}" Width="140"/>
                    <DataGridTextColumn Header="测试点" Binding="{Binding TestName}" Width="140"/>
                    <DataGridTextColumn Header="数据类型" Binding="{Binding DataType}" Width="78"/>
                    <DataGridTextColumn Header="下限" Binding="{Binding MinLimit}" Width="70"/>
                    <DataGridTextColumn Header="上限" Binding="{Binding MaxLimit}" Width="70"/>
                    <DataGridTextColumn Header="判定符号" Binding="{Binding ComparisonOperator}" Width="80"/>
                    <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="58"/>
                    <DataGridTextColumn Header="测试值" Binding="{Binding TestValue}" Width="80"/>
                    <DataGridTextColumn Header="结果" Binding="{Binding TestResult}" Width="58"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
