<Window x:Class="ATS5.Wpf.Views.Shell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ATS5.Wpf.Core;assembly=ATS5.Wpf.Core"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:prism="http://prismlibrary.com/"
        Title="测试系统"
        Width="1280"
        Height="820"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontFamily="Microsoft YaHei UI"
        Background="#F4F7FB">
    <Window.Resources>
        <SolidColorBrush x:Key="AtsBlueBrush" Color="#106EBE"/>
        <SolidColorBrush x:Key="AtsBlueDarkBrush" Color="#0D5D9F"/>
        <SolidColorBrush x:Key="AtsPanelBorderBrush" Color="#D7E1EC"/>

        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="#1F2A35"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E7F1FB"/>
                                <Setter Property="BorderBrush" Value="#B8D5EF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D2E7FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileNavigationButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="126"/>
            <Setter Property="Height" Value="62"/>
            <Setter Property="Margin" Value="5,4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AtsBlueBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AtsBlueDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Tag}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           Margin="0,8,0,0"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#EAF5FF"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Bottom"
                                                  Margin="0,0,0,8"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A7CCF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0A5795"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.62"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Height="32"
                Background="White"
                BorderBrush="{StaticResource AtsPanelBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <TextBlock Text="GeekTest ATS V5.0.0"
                               FontWeight="Bold"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="工具">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="DBC工具"/>
                                <MenuItem Header="UDS工具"/>
                                <MenuItem Header="CAN模拟工具"/>
                                <MenuItem Header="CAN自检工具"/>
                                <Separator/>
                                <MenuItem Header="第三方工具"/>
                                <MenuItem Header="数据迁移工具"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="系统">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="设置"/>
                                <MenuItem Header="帮助"/>
                                <MenuItem Header="关于"/>
                                <MenuItem Header="注册"/>
                                <Separator/>
                                <MenuItem Header="语言">
                                    <MenuItem Header="简体中文"/>
                                    <MenuItem Header="繁体中文"/>
                                    <MenuItem Header="英文"/>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="测试系统"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#1F2A35"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="admin【管理员】">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="更改密码"/>
                                <MenuItem Header="注销"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="隐藏菜单栏"/>
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="显示菜单栏"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
                Height="66"
                Background="#F7FAFD"
                BorderBrush="{StaticResource AtsPanelBorderBrush}"
                BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="6,0">
                    <Button Style="{StaticResource TileNavigationButtonStyle}"
                            Content="产品测试"
                            Tag="PT"
                            AutomationProperties.AutomationId="NavProductTest"
                            Command="{Binding NavigateProductTestCommand}"/>
                    <Button Style="{StaticResource TileNavigationButtonStyle}"
                            Content="数据查询"
                            Tag="DQ"
                            AutomationProperties.AutomationId="NavDataQuery"
                            Command="{Binding NavigateDataQueryCommand}"/>
                    <Button Style="{StaticResource TileNavigationButtonStyle}"
                            Content="流程管理"
                            Tag="FW"
                            AutomationProperties.AutomationId="NavFlow"
                            Command="{Binding NavigateFlowCommand}"/>
                    <Button Style="{StaticResource TileNavigationButtonStyle}"
                            Content="设备管理"
                            Tag="DV"
                            AutomationProperties.AutomationId="NavDevice"
                            Command="{Binding NavigateDeviceCommand}"/>
                    <Button Style="{StaticResource TileNavigationButtonStyle}"
                            Content="权限管理"
                            Tag="AU"
                            AutomationProperties.AutomationId="NavAuthority"
                            Command="{Binding NavigateAuthorityCommand}"/>
                    <Button Style="{StaticResource TileNavigationButtonStyle}"
                            Content="MES"
                            Tag="ME"
                            AutomationProperties.AutomationId="NavMes"
                            IsEnabled="False"/>
                    <Button Style="{StaticResource TileNavigationButtonStyle}"
                            Content="自动化"
                            Tag="AT"
                            AutomationProperties.AutomationId="NavAutoTest"
                            IsEnabled="False"/>
                    <Button Style="{StaticResource TileNavigationButtonStyle}"
                            Content="统计信息"
                            Tag="ST"
                            AutomationProperties.AutomationId="NavStatisticalInfo"
                            Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StatusBar DockPanel.Dock="Bottom"
                   Height="24"
                   Background="White"
                   BorderBrush="{StaticResource AtsPanelBorderBrush}"
                   BorderThickness="0,1,0,0">
            <TextBlock Text="©深圳市极测科技有限公司"
                       FontWeight="Bold"
                       FontSize="12"/>
            <Separator/>
            <TextBlock Text="样板范围：产品测试壳 / 数据查询 / 流程管理 / 设备管理 / 权限管理 UI 结构复刻"/>
        </StatusBar>

        <Border BorderBrush="{StaticResource AtsPanelBorderBrush}"
                BorderThickness="0"
                Background="White">
            <ContentControl prism:RegionManager.RegionName="{x:Static core:RegionNames.ContentRegion}"/>
        </Border>
    </DockPanel>
</Window>
