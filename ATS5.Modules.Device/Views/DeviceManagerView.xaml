<UserControl x:Class="ATS5.Modules.Device.Views.DeviceManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewModels="clr-namespace:ATS5.Modules.Device.ViewModels"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="White">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type viewModels:DeviceLibraryNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}"/>
        </HierarchicalDataTemplate>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#EEF3F8"/>
            <Setter Property="Padding" Value="0,6,0,0"/>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                BorderBrush="#D7E1EC"
                BorderThickness="0,0,0,1"
                Background="#F7FAFD">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            Margin="4,2">
                    <Button Content="新建"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding NewCommand}"/>
                    <Button Content="编辑"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding EditCommand}"/>
                    <Button Content="打开"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding OpenCommand}"/>
                    <Button Content="保存"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="另存为"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding SaveAsCommand}"/>
                    <Button Content="取消"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding CancelCommand}"/>
                    <Button Content="配置设备调试"
                            Style="{StaticResource ToolbarButtonStyle}"
                            IsEnabled="False"/>
                    <Button Content="清除全局参数"
                            Style="{StaticResource ToolbarButtonStyle}"
                            IsEnabled="False"/>
                </StackPanel>
                <TextBlock Text="{Binding Title}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"
                           FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#D7E1EC"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="设备库"
                               Style="{StaticResource PanelHeaderStyle}"/>
                    <TextBox DockPanel.Dock="Top"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             hc:InfoElement.Placeholder="请输入检索内容"
                             Margin="6"/>
                    <TreeView ItemsSource="{Binding DeviceLibraryNodes}"
                              SelectedItemChanged="DeviceLibrary_SelectedItemChanged"
                              MouseDoubleClick="DeviceLibrary_MouseDoubleClick">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="#D7E1EC"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="设备配置信息"
                               Style="{StaticResource PanelHeaderStyle}"/>
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="4">
                        <Button Content="下移"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding MoveDownCommand}"/>
                        <Button Content="上移"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding MoveUpCommand}"/>
                        <Button Content="置顶"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding MoveTopCommand}"/>
                        <Button Content="删除"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding DeviceConfigs}"
                              SelectedItem="{Binding SelectedDeviceConfig}"
                              IsReadOnly="{Binding IsGridReadOnly}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="All"
                              GridLinesVisibility="All">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnable}"/>
                            <DataGridTextColumn Header="设备类型" Binding="{Binding DevType}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="设备名称" Binding="{Binding DevName}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="底层类名" Binding="{Binding DevClasss}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="设备编码" Binding="{Binding DevCode}"/>
                            <DataGridTextColumn Header="初始化参数" Binding="{Binding InitPars}"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding Remark}"/>
                            <DataGridCheckBoxColumn Header="全局参数" Binding="{Binding IsGlobal}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top"
                           Text="设备初始化参数说明"
                           Style="{StaticResource PanelHeaderStyle}"/>
                <TextBox Text="{Binding InitRemark}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Margin="6"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
